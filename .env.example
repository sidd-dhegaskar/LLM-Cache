# Phase 1: no real LLM key needed by default — app/main.py talks to the mock LLM server.
MOCK_LLM_URL=http://localhost:9000
MOCK_LLM_LATENCY_MS=800
MOCK_LLM_COST_PER_CALL=0.002

# Real LLM backend switch: "mock" (default) or "gemini".
# Set to "gemini" and provide GEMINI_API_KEY to call the real Gemini API instead of the mock —
# switch back to "mock" for load testing (Phase 5) to avoid real API cost/quota.
# Uses Google's Interactions API (POST /v1beta/interactions) — several older model names/the
# generateContent endpoint 404 or have zero free-tier quota; gemini-3.6-flash is confirmed
# working on a free-tier key as of this project's testing.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Real per-token pricing for GEMINI_MODEL, in $ per 1 million tokens — used to compute real
# cost from the token counts Gemini reports per call (usageMetadata), instead of a flat guess.
GEMINI_INPUT_PRICE_PER_1M=0.75
GEMINI_OUTPUT_PRICE_PER_1M=3.75

# Phase 3: semantic cache similarity threshold.
# Calibrated against all-MiniLM-L6-v2's real similarity range (see eval/inspect_similarities.py) —
# generic thresholds like 0.85-0.95 are too high for this model and produce near-zero hit rate.
SIMILARITY_THRESHOLD=0.65

# Phase 4: Redis connection — run `docker compose up -d` to start Redis Stack locally.
REDIS_URL=redis://localhost:6379
