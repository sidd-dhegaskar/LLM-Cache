# Phase 1: no real LLM key needed — app/main.py talks to the mock LLM server instead.
MOCK_LLM_URL=http://localhost:9000
MOCK_LLM_LATENCY_MS=800
MOCK_LLM_COST_PER_CALL=0.002

# Phase 3: semantic cache similarity threshold.
# Calibrated against all-MiniLM-L6-v2's real similarity range (see eval/inspect_similarities.py) —
# generic thresholds like 0.85-0.95 are too high for this model and produce near-zero hit rate.
SIMILARITY_THRESHOLD=0.65
